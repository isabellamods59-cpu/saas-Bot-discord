# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  NexaBot — Configuração (.env)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Token do bot (Discord Developer Portal)
DISCORD_TOKEN=SEU_TOKEN_AQUI

# ID do cliente do bot
CLIENT_ID=SEU_CLIENT_ID_AQUI

# ID do desenvolvedor (acesso ao /devpainel)
DEV_ID=SEU_ID_AQUI

# MongoDB URI
MONGO_URI=mongodb://localhost:27017/nexabot

# Prefixo opcional para comandos de texto
PREFIX=!
